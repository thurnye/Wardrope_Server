NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=wardrope
AUTH_SESSION_TTL_HOURS=24
AWS_REGION=ca-central-1
AWS_S3_BUCKET_NAME=your-private-wardrope-bucket
AWS_S3_ROOT_PREFIX=wardrope
WEATHER_API_KEY=your-weatherapi-com-server-key
# Optional. Configure this to route browser fallbacks through a proxy for blocked remote sites.
# PRODUCT_SOURCE_BROWSER_PROXY_URL=http://user:password@proxy.example.com:3128

# Optional. Configure both to enable the OpenAI Dress Me provider.
# If both are omitted, Wardrope uses the deterministic baseline provider.
# OPENAI_API_KEY=your-server-only-openai-api-key
# OPENAI_DRESS_ME_MODEL=your-responses-compatible-model
